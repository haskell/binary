cabal-version:  3.0
name:            binary
version:         0.8.9.2
license:         BSD-3-Clause
license-file:    LICENSE
author:          Lennart Kolmodin <kolmodin@gmail.com>
maintainer:      konsumlamm <konsumlamm@gmail.com>
homepage:        https://github.com/haskell/binary
description:     Efficient, pure binary serialisation using lazy ByteStrings.
                 Haskell values may be encoded to and from binary formats,
                 written to disk as binary, or sent over the network.
                 The format used can be automatically generated, or
                 you can choose to implement a custom format if needed.
                 Serialisation speeds of over 1 G\/sec have been observed,
                 so this library should be suitable for high performance
                 scenarios.
synopsis:        Binary serialisation for Haskell values using lazy ByteStrings
category:        Data, Parsing
stability:       provisional
build-type:      Simple
tested-with:     GHC == 8.0.2, GHC ==8.2.2, GHC == 8.4.4, GHC == 8.6.5, GHC == 8.8.4, GHC == 8.10.7, GHC == 9.0.2, GHC == 9.2.8, GHC == 9.4.8, GHC == 9.6.7, GHC == 9.8.4, GHC == 9.10.3, GHC == 9.12.2, GHC == 9.14.1
extra-source-files:
  tools/derive/*.hs
extra-doc-files:
  README.md changelog.md docs/hcar/binary-Lb.tex

source-repository head
  type: git
  location: https://github.com/haskell/binary.git

-- NOTE: The library stanza below is duplicated in
-- binary-tests/binary-tests.cabal (so tests and benchmarks can build against
-- local sources without colliding with GHC's boot binary package). Any changes
-- to modules, build-depends, c-sources, include-dirs, or ghc-options here MUST
-- be mirrored in binary-tests/binary-tests.cabal.
library
  build-depends:    base >= 4.9 && < 5, bytestring >= 0.10.4, containers, array
  hs-source-dirs:   src
  exposed-modules:  Data.Binary
                    Data.Binary.Put
                    Data.Binary.Get
                    Data.Binary.Get.Internal
                    Data.Binary.Get.Internal.Buf
                    Data.Binary.Builder

  other-modules:    Data.Binary.Class
                    Data.Binary.Internal
                    Data.Binary.Generic
                    Data.Binary.FloatCast
  include-dirs:     cbits
  install-includes: unaligned_read.h
  c-sources:        cbits/unaligned_read.c
  ghc-options:      -O2 -Wall -fliberate-case-threshold=1000

  if impl(ghc >= 8.0)
    ghc-options: -Wcompat -Wnoncanonical-monad-instances
  default-language: Haskell2010
